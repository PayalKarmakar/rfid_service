<Window x:Class="RfidManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID Service"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="RFID SERVICE"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="RFID reader communication and transaction processing service"
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- SERVICE STATUS -->
            <Border Grid.Column="1"
                    Background="#DCFCE7"
                    CornerRadius="20"
                    Padding="15,8"
                    VerticalAlignment="Top">

                <TextBlock Text="● SERVICE RUNNING"
                           Foreground="#16A34A"
                           FontWeight="SemiBold"/>

            </Border>

        </Grid>


        <!-- SERVER STATUS -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ENTRY SERVER -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="ENTRY RFID SERVER"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"/>

                    <TextBlock Text="● RUNNING"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,15,0,0"/>

                    <TextBlock x:Name="txtEntryPort"
                               Text="TCP Port: --"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"/>       

                    <TextBlock Text="Waiting for ENTRY reader connection"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- EXIT SERVER -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="EXIT RFID SERVER"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"/>

                    <TextBlock Text="● RUNNING"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,15,0,0"/>

                    <TextBlock x:Name="txtExitPort"
                               Text="TCP Port: --"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,8,0,0"/>   

                    <TextBlock Text="Waiting for EXIT reader connection"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- LATEST RFID DATA -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="LATEST RFID DATA"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>


                <TextBlock Grid.Row="2"
                           Text="Latest data received from RFID readers"
                           FontSize="13"
                           Foreground="#64748B"/>


                <Border Grid.Row="4"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <TextBlock x:Name="txtReceivedData"
                                   Text="Waiting for RFID reader data..."
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"/>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Border>


        <!-- FOOTER -->
        <Border Grid.Row="5"
                Background="Transparent"
                Margin="0,20,0,0">

            <TextBlock Text="RFID Management System Service"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8"
                       FontSize="12"/>

        </Border>

    </Grid>

</Window>