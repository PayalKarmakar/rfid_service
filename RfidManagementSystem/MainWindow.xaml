<Window x:Class="RfidManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID Management System"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#0F172A">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- APPLICATION LOGO / NAME -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="RFID"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="MANAGEMENT SYSTEM"
                               Foreground="#94A3B8"
                               FontSize="11"
                               Margin="0,5,0,0"
                              />
                </StackPanel>


                <!-- MENU -->
                <StackPanel Grid.Row="1">

                    <Button Content="⌂   Dashboard"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="#1E293B"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Content="👤   Employees"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="▣   RFID Cards"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="▣   Readers"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="◉   Sensors"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="▣   CCTV / Cameras"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="☷   Transactions"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                    <Button Content="▤   Reports"
                            Height="45"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Margin="0,5"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"/>

                </StackPanel>


                <!-- SETTINGS -->
                <Button Grid.Row="2"
                        Content="⚙   Settings"
                        Height="45"
                        HorizontalContentAlignment="Left"
                        Padding="15,0"
                        Background="Transparent"
                        Foreground="#CBD5E1"
                        BorderThickness="0"/>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Dashboard"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Monitor your RFID, CCTV and sensor system"
                               FontSize="14"
                               Foreground="#64748B"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Administrator"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>

                    <TextBlock Text="System Administrator"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>


            <!-- STATUS CARDS -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- RFID -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="RFID READER"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="● Connected"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#16A34A"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="No reader connected yet"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CCTV -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="CCTV / CAMERA"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="● Offline"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#DC2626"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="No camera connected yet"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- SENSOR -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="SENSOR"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="● Waiting"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#D97706"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Sensor not configured"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- TODAY -->
                <Border Grid.Column="6"
                        Background="White"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="TODAY'S EVENTS"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="No events recorded today"
                                   FontSize="12"
                                   Foreground="#94A3B8"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- LOWER SECTION -->
            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>


                <!-- LIVE EVENTS -->
                <!-- LIVE EVENTS -->
                <Border Grid.Column="0"
        Background="White"
        CornerRadius="12"
        Padding="25">

                    <StackPanel>

                        <!-- TITLE -->
                        <TextBlock Text="Live Events"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>

                        <TextBlock Text="RFID and sensor activity will appear here"
                   Foreground="#64748B"
                   Margin="0,5,0,25"/>


                        <!-- RFID RECEIVED DATA -->
                        <Border Background="#F8FAFC"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20">

                            <StackPanel>

                                <TextBlock Text="Received Data"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,8"/>

                                <TextBlock x:Name="txtReceivedData"
                           Text="Waiting for RFID reader events..."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>


                        <!-- SEND MESSAGE TO CLIENT -->
                        <TextBlock Text="Send Message to Client"
                   FontWeight="SemiBold"
                   Foreground="#475569"
                   Margin="0,0,0,8"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>


                            <!-- MESSAGE INPUT -->
                            <TextBox x:Name="txtMessage"
                     Grid.Column="0"
                     Height="40"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>


                            <!-- SEND BUTTON -->
                            <Button Grid.Column="1"
                    Content="Send"
                    Height="40"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SendToClient_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- LATEST CAPTURE -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="Latest CCTV Capture"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>

                        <Border Height="220"
                Background="#E2E8F0"
                CornerRadius="8"
                ClipToBounds="True">

            <Grid>
<Image x:Name="imgCctvCapture"
                       Stretch="UniformToFill"/>

                <TextBlock x:Name="txtNoImage"
                           Text="NO IMAGE"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                       </Grid>

        </Border>
         <!-- TEMPORARY TEST BUTTON -->
        <Button Content="Take Snapshot"
                Width="150"
                Height="40"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Click="TakeSnapshot_Click"/>
                        <StackPanel>

    <Border Height="220"
            Background="#E2E8F0"
            CornerRadius="8">

        <TextBlock Text="NO IMAGE"
                   Foreground="#94A3B8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>

    </Border>

    <Button Content="Take Snapshot"
            Height="40"
            Margin="0,15,0,0"
            Click="TakeSnapshot_Click"/>

</StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>